<UserControl
    x:Class="HAFIZ.App.Views.LyricsStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="HafizLoc1" Style="{StaticResource HafizSectionTitleStyle}" Text="استوديو الكلمات" />
            <TextBlock x:Name="HafizLoc2"
                Foreground="{ThemeResource HafizTextSecondaryBrush}"
                Text="تشكيل عامي مصري، كتابة أغاني، ضبط القوافي، إعادة الصياغة، الإملاء، والنطق المصري" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource HafizCardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="RecordButton" Click="OnRecordClick" Content="🎤 تسجيل" />
                            <Button x:Name="HafizLoc3" Click="OnClearRecordingClick" Content="استخدام النص المكتوب" />
                            <Button x:Name="HafizLoc4" Click="OnCancelClick" Content="إلغاء" />
                        </StackPanel>
                        <ComboBox x:Name="DiacriticsMode" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem x:Name="HafizLoc5" Content="تشكيل ذكي بالعامية" Tag="Smart Diacritics" />
                            <ComboBoxItem x:Name="HafizLoc6" Content="تشكيل للنطق في Suno" Tag="Suno Phonetic" />
                            <ComboBoxItem x:Name="HafizLoc7" Content="نطق مصري متصل" Tag="Connected Egyptian" />
                            <ComboBoxItem x:Name="HafizLoc8" Content="تدقيق" Tag="Proofread" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="HafizLoc9" Click="OnDiacritizeClick" Style="{StaticResource AccentButtonStyle}" Content="تشكيل عامي مصري" />
                        <Button x:Name="HafizLoc10" Click="OnRhymeCheckClick" Content="فحص القافية والوزن" />
                        <Button x:Name="HafizLoc11" Click="OnRewriteClick" Content="إعادة صياغة" />
                        <Button x:Name="HafizLoc12" Click="OnSpeakLyricsClick" Content="🔊 نطق مصري" />
                        </StackPanel>
                    </StackPanel>

                    <TextBox
                        x:Name="LyricsEditor"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontSize="16"
                        PlaceholderText="اكتب كلمات الأغنية بالعامية المصرية هنا..." />

                    <TextBlock
                        x:Name="LyricsStatusText"
                        Grid.Row="2"
                        Foreground="{ThemeResource HafizTextSecondaryBrush}"
                        Text="جاهز للكتابة والتشكيل المحلي" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource HafizCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HafizLoc13" FontSize="15" FontWeight="SemiBold" Text="إخراج وتصدير" />
                    <TextBox
                        x:Name="PromptOutputBox"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="240"
                        IsReadOnly="True"
                        PlaceholderText="المخرجات والبرومبت الموسيقي ستظهر هنا..." />
                    <Button x:Name="HafizLoc14" Click="OnExportTextClick" Content="حفظ كملف نصي (.txt)" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
