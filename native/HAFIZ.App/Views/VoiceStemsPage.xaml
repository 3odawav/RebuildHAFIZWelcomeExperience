<UserControl
    x:Class="HAFIZ.App.Views.VoiceStemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="HafizLoc1" Style="{StaticResource HafizSectionTitleStyle}" Text="استنساخ الصوت وفصل 6 تراكات" />
            <TextBlock x:Name="HafizLoc2"
                Foreground="{ThemeResource HafizTextSecondaryBrush}"
                Text="عزل الغناء BS-RoFormer، فصل 6 تراكات Demucs، وتحويل غنائي محلي Seed-VC" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource HafizCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HafizLoc3" FontSize="15" FontWeight="SemiBold" Text="فصل التراكات — BS-RoFormer وDemucs" />
                    <TextBox x:Name="MixInputPathBox" PlaceholderText="مسار الأغنية الأصلية (WAV / FLAC / MP3)..." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="HafizLoc4" Click="OnRunBsRoformerClick" Style="{StaticResource AccentButtonStyle}" Content="عزل غنائي BS-RoFormer" />
                        <Button x:Name="HafizLoc5" Click="OnRunDemucs6StemsClick" Content="فصل 6 تراكات (Demucs)" />
                    </StackPanel>
                    <TextBlock x:Name="HafizLoc6"
                        Foreground="{ThemeResource HafizTextSecondaryBrush}"
                        Text="التراكات: الغناء، الدرامز، الباص، الجيتار، البيانو، وأخرى. حماية GPU للمحركات المملوكة لحافظ فقط."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource HafizCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HafizLoc7" FontSize="15" FontWeight="SemiBold" Text="تحويل الصوت والغناء المعتمد — Seed-VC" />
                    <TextBox x:Name="ReferenceVoicePathBox" PlaceholderText="مسار العينة الصوتية المرخصة (10–30 ثانية WAV)..." />
                    <CheckBox x:Name="VoiceConsentCheck" Content="أؤكد أنني أملك الإذن الكامل لاستخدام هذه العينة الصوتية" />
                    <Button x:Name="HafizLoc8" Click="OnRunSeedVcClick" Style="{StaticResource AccentButtonStyle}" Content="تحويل غنائي عبر Seed-VC (FP16 SM75)" />
                    <TextBlock
                        x:Name="VoiceStemsStatus"
                        Foreground="{ThemeResource HafizTextSecondaryBrush}"
                        Text="حالة المحركات تظهر بعد الاتصال الفعلي."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
