<UserControl
    x:Class="HAFIZ.App.Views.SettingsCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Centralized Settings Center containing ALL technical settings in one organized location:
         1. General, 2. Assistant, 3. Speech, 4. Microphone, 5. AI Models & LM Studio, 6. Multi-Drive Scanner,
         7. GPU & VRAM Guard, 8. Downloads, 9. Storage, 10. Audio, 11. Memory, 12. Updates, 13. Security, 14. Diagnostics -->
    <ScrollViewer Padding="24">
        <StackPanel Spacing="18" MaxWidth="1040">
            <StackPanel Spacing="4">
                <TextBlock x:Name="HafizLoc1" Style="{StaticResource HafizSectionTitleStyle}" Text="مركز الإعدادات الشامل" />
                <TextBlock x:Name="HafizLoc2"
                    Foreground="{ThemeResource HafizTextSecondaryBrush}"
                    Text="إعدادات الواجهة واللغات والثيمات، LM Studio، فحص الموديلات بدون نقل، كارت الشاشة والتحميلات" />
            </StackPanel>

            <!-- 1. General: Language & 3 Official Themes -->
            <Border Style="{StaticResource HafizCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HafizLoc3" FontSize="15" FontWeight="SemiBold" Text="1. العام والواجهة" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="HafizLoc4" Click="OnSetArabicClick" Content="العربية (مصر — RTL)" />
                        <Button x:Name="HafizLoc5" Click="OnSetEnglishClick" Content="الإنجليزية (LTR)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="HafizLoc6" Click="OnThemeDayClick" Content="نهاري: أبيض / أزرق كروم" />
                        <Button x:Name="HafizLoc7" Click="OnThemeNightClick" Content="ليلي: جرافيت / ذهبي" />
                        <Button x:Name="HafizLoc8" Click="OnThemeMidnightClick" Content="أزرق ليلي" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. AI Models & LM Studio Provider -->
            <Border Style="{StaticResource HafizCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HafizLoc9" FontSize="15" FontWeight="SemiBold" Text="2. مزوّد نماذج الذكاء الاصطناعي" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <RadioButton x:Name="ProviderHafizRadio" GroupName="LlmProvider" Content="محرك حافظ المحلي llama.cpp" Checked="OnProviderHafizChecked" />
                        <RadioButton x:Name="ProviderLmStudioRadio" GroupName="LlmProvider" Content="واجهة LM Studio المحلية (127.0.0.1:1234)" Checked="OnProviderLmStudioChecked" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LmStudioUrlBox" Grid.Column="0" Text="http://127.0.0.1:1234" PlaceholderText="LM Studio — عنوان الخادم المحلي" />
                        <Button x:Name="HafizLoc10" Grid.Column="1" Click="OnDiscoverLmStudioClick" Style="{StaticResource AccentButtonStyle}" Content="فحص نماذج LM Studio" />
                    </Grid>
                    <TextBlock x:Name="LmStudioStatusText" Foreground="{ThemeResource HafizTextSecondaryBrush}" Text="يتم اكتشاف نماذج LM Studio بدون تغيير الموديلات المحملة خارجيًا." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HafizCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="HafizLoc11" FontWeight="SemiBold" Text="محركات حافظ المحلية" />
                    <TextBlock x:Name="HafizLoc12" TextWrapping="Wrap" Text="اتصال محلي متوافق مع OpenAI فقط. حدد الخادم ومعرّفات الموديلات. لا اتصال سحابي أو تحكم تلقائي في برامج خارجية." />
                    <TextBox x:Name="LocalLlmUrl" Header="عنوان llama-server" />
                    <TextBox x:Name="LocalLlmModel" Header="معرّف نموذج اللغة (اختياري لو نموذج واحد)" />
                    <TextBox x:Name="LocalAsrUrl" Header="عنوان خادم التفريغ الصوتي" />
                    <TextBox x:Name="LocalAsrModel" Header="معرّف نموذج التفريغ الصوتي" />
                    <TextBox x:Name="LocalTtsUrl" Header="عنوان خادم النطق الصوتي" />
                    <TextBox x:Name="LocalTtsModel" Header="معرّف نموذج النطق الصوتي" />
                    <TextBox x:Name="LocalTtsVoice" Header="معرّف الصوت المصري" />
                    <TextBlock x:Name="LocalEndpointStatus" TextWrapping="Wrap" />
                    <Button x:Name="HafizLoc13" Click="OnSaveLocalEndpointsClick" Content="حفظ المحركات المحلية" />
                </StackPanel>
            </Border>

            <!-- 3. Multi-Drive In-Place Model Scanner (E:, D:, D:\AI\LMStudio-Models\local) -->
            <Border Style="{StaticResource HafizCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HafizLoc14" FontSize="15" FontWeight="SemiBold" Text="3. فحص البارتيشنات بدون نقل الموديلات" />
                    <TextBlock x:Name="HafizLoc15"
                        Foreground="{ThemeResource HafizTextSecondaryBrush}"
                        Text="حافظ يفهرس الموديلات في مساراتك المختارة بدون نسخ أو نقل أو حذف أي ملف."
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomScanPathBox" Grid.Column="0" PlaceholderText="أضف مسار بارتيشن أو مجلد..." />
                        <Button x:Name="HafizLoc16" Grid.Column="1" Click="OnAddScanRootClick" Content="إضافة مسار" />
                        <Button x:Name="HafizLoc17" Grid.Column="2" Click="OnScanDrivesClick" Style="{StaticResource AccentButtonStyle}" Content="ابدأ الفحص الآن" />
                    </Grid>
                    <TextBlock x:Name="ScanSummaryText" Foreground="{ThemeResource HafizTextSecondaryBrush}" Text="مسارات الفحص المختارة" />
                </StackPanel>
            </Border>

            <!-- 4. GPU & 16GB VRAM Guard (NVIDIA Quadro RTX 5000 SM75) -->
            <Border Style="{StaticResource HafizCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HafizLoc18" FontSize="15" FontWeight="SemiBold" Text="4. كارت الشاشة وحماية ذاكرة VRAM" />
                    <TextBlock x:Name="GpuTelemetryDetailText" Foreground="{ThemeResource HafizTextSecondaryBrush}" Text="جاري فحص كارت الشاشة…" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="HafizLoc19" Click="OnRefreshGpuClick" Content="تحديث قراءة كارت الشاشة" />
                        <Button x:Name="HafizLoc20" Click="OnPurgeHafizVramClick" Style="{StaticResource AccentButtonStyle}" Content="تفريغ ذاكرة حافظ فقط" />
                    </StackPanel>
                    <TextBlock x:Name="HafizLoc21"
                        Foreground="{ThemeResource HafizTextSecondaryBrush}"
                        Text="حافظ لا يوقف أو يفرّغ عمليات Unsloth وLM Studio وComfyUI الخارجية."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 5. Assistant, Speech, Microphone, Downloads, Storage, Audio, Memory, Updates, Security & Diagnostics -->
            <Border Style="{StaticResource HafizCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="HafizLoc22" FontSize="15" FontWeight="SemiBold" Text="5. المساعد والصوت والميكروفون والتحميلات والتخزين والتحديثات والأمان" />
                    <TextBlock x:Name="StoragePathSummary" Foreground="{ThemeResource HafizTextSecondaryBrush}" Text="مسارات التطبيق والموديلات" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="HafizLoc23" Click="OnToggleFloatingSideClick" Content="تبديل مكان حافظ العائم (يمين / يسار)" />
                        <Button x:Name="HafizLoc24" Click="OnSaveAllSettingsClick" Content="حفظ الإعدادات نهائيًا" />
                    </StackPanel>
                    <TextBlock x:Name="SettingsActionStatus" Foreground="{ThemeResource HafizAccentBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
