<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Three Official HAFIZ Fluent Themes:
         1. DayWhiteBlue (Light): Crisp white studio + chrome blue accents
         2. NightGraphiteGold (Dark): Deep graphite + luxury gold accents
         3. MidnightBlue (Dark): Deep midnight navy + electric Matrix cyan/blue accents -->

    <ResourceDictionary.ThemeDictionaries>
        <!-- Day: White & Chrome Blue -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="HafizCanvasBrush" Color="#F5F8FC" />
            <SolidColorBrush x:Key="HafizSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HafizSurfaceAltBrush" Color="#EBF2FA" />
            <SolidColorBrush x:Key="HafizBorderBrush" Color="#CFDCEB" />
            <SolidColorBrush x:Key="HafizTextPrimaryBrush" Color="#0F1C2E" />
            <SolidColorBrush x:Key="HafizTextSecondaryBrush" Color="#475D77" />
            <SolidColorBrush x:Key="HafizAccentBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="HafizAccentGlowBrush" Color="#0EA5E9" />
            <SolidColorBrush x:Key="HafizMatrixHaloBrush" Color="#0284C7" />
            <SolidColorBrush x:Key="HafizDangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="HafizSuccessBrush" Color="#0F7B0F" />
        </ResourceDictionary>

        <!-- Night: Graphite & Gold (Default Dark) -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HafizCanvasBrush" Color="#111318" />
            <SolidColorBrush x:Key="HafizSurfaceBrush" Color="#191D24" />
            <SolidColorBrush x:Key="HafizSurfaceAltBrush" Color="#222731" />
            <SolidColorBrush x:Key="HafizBorderBrush" Color="#2F3744" />
            <SolidColorBrush x:Key="HafizTextPrimaryBrush" Color="#F3F5F8" />
            <SolidColorBrush x:Key="HafizTextSecondaryBrush" Color="#A3AFBF" />
            <SolidColorBrush x:Key="HafizAccentBrush" Color="#D4AF37" />
            <SolidColorBrush x:Key="HafizAccentGlowBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="HafizMatrixHaloBrush" Color="#00C8FF" />
            <SolidColorBrush x:Key="HafizDangerBrush" Color="#F87171" />
            <SolidColorBrush x:Key="HafizSuccessBrush" Color="#34D399" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Midnight Blue Override Palette (applied dynamically when MidnightBlue theme is active) -->
    <Color x:Key="MidnightCanvasColor">#07101E</Color>
    <Color x:Key="MidnightSurfaceColor">#0D1B30</Color>
    <Color x:Key="MidnightSurfaceAltColor">#132642</Color>
    <Color x:Key="MidnightBorderColor">#1E3B63</Color>
    <Color x:Key="MidnightAccentColor">#00B7FF</Color>

    <Style x:Key="HafizCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HafizSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HafizBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="HafizSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HafizTextPrimaryBrush}" />
    </Style>
</ResourceDictionary>
